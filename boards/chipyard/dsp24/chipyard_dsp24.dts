/dts-v1/;

#include <chipyard/chipyard-riscv64.dtsi>

/ {
	chosen {
		zephyr,console= &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &ram0;
		zephyr,flash = &flash0;
	};

	aliases {
		bmi088-accel = &bmi088_accel;
		bmi088-gyro = &bmi088_gyro;
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;  // Set appropriate baud rate
};

&i2c0 {
	status = "okay";

	bmi088_accel: bmi08x@69 {
		compatible = "bosch,bmi08x-accel";
		reg = <0x18>;
		accel-hz = "800";
		accel-fs = <6>;
	};

	bmi088_gyro: bmi08x@18 {
		compatible = "bosch,bmi08x-gyro";
		reg = <0x69>;
		gyro-hz = "1000_116";
		gyro-fs = <1000>;
	};
};

&htif {
	status = "disabled";
};

// &ram0 {
// 	reg = < 0x08000000 0x00008000 >;
// };

&ram0 {
	reg = < 0x80000000 0x00080000 >;
};

&flash0 {
	status = "okay";
};


